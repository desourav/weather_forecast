# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored and will never be committed.

# Finnhub API key — used by the stock panel and S&P 500 ticker
# Get one free at https://finnhub.io
FINNHUB_API_KEY=

# New York Times API key — used by the news panel
# Get one free at https://developer.nytimes.com
NYT_API_KEY=
